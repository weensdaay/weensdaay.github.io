{
  "name": "wensday-analytics",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "send_metrics": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wensday-analytics",
      "database_id": "REPLACE_AFTER_PROVISIONING",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "INGEST_LIMITER",
      "namespace_id": "671410",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 4 * * *"] }
}
